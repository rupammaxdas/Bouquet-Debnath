# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# IMPORTANT:
# 1. Do NOT commit real secrets or credentials to source control.
# 2. Copy this file to '.env' for local development: cp .env.example .env
# 3. Ensure '.env' is in your .gitignore.
# ==============================================================================

# --- SERVER-SIDE ONLY SECRETS (NEVER EXPOSE TO CLIENT) ---
# GEMINI_API_KEY: Required for server-side Gemini AI image generation & processing.
# Kept securely on the Node.js / Express backend.
GEMINI_API_KEY="your-gemini-api-key-here"

# PORT: The port on which the Express server runs (default: 3000).
PORT=3000

# NODE_ENV: Runtime environment (development | production)
NODE_ENV="development"

# APP_URL: The base URL of the hosted application (for callbacks and webhooks)
APP_URL="http://localhost:3000"

# --- CLIENT-SIDE SAFE PUBLIC CONFIGURATION ---
# Note: Any variable prefixed with VITE_ is bundled into client-side code.
# NEVER place private keys, database passwords, or service role secrets in VITE_ variables.
# Firebase web configuration uses public identifiers protected by Firestore Security Rules.
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="your-firestore-database-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
